# Terraform local working directory
.terraform/

# Terraform state files (HCP stores state remotely, still ignore local ones)
*.tfstate
*.tfstate.*

# Terraform plan output
*.tfplan

# Crash logs
crash.log
crash.*.log

# Sensitive variable files (never commit)
*.tfvars
*.tfvars.json

# CLI config files (may contain tokens)
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS junk
.DS_Store
Thumbs.db

# IDE settings
.vscode/
.idea/
